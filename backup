#!/data/data/com.termux/files/usr/bin/bash

set -e

command -v zip >/dev/null 2>&1 || {
    echo "Error: zip is missing. Run: pkg install zip"
    exit 1
}

PROJECT="$HOME/RamGhost-V2-Working"
ARCHIVE="$HOME/RamGhost-V2-Full-Backup-$(date +%Y%m%d-%H%M%S).zip"

if [[ ! -d "$PROJECT" ]]; then
    echo "Project directory not found."
    exit 1
fi

cd "$PROJECT"

zip -r "$ARCHIVE" . \
    -x ".git/*" \
       ".git" \
       "cyber-reports/*" \
       "*.tmp" >/dev/null

echo
echo "RamGhost V2.0 full project backup created:"
echo "$ARCHIVE"
echo
ls -lh "$ARCHIVE"
